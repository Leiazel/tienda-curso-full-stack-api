# Servidor HTTP
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
# Opcional: URL pública base para resolver rutas relativas de imágenes (/images/...)
# Si queda vacío, se resuelve automáticamente usando el host de la request (ej: http://localhost:3000)
PUBLIC_BASE_URL=

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ld_store_db
DB_CONNECTION_LIMIT=10

# Autenticación JWT
JWT_SECRET=cambia_esta_clave_secreta_en_produccion
JWT_EXPIRES_IN=7d

# Protección de rutas administrativas (POST/PUT/PATCH/DELETE de catálogo y gestión)
# false: permite probar endpoints CRUD directamente durante el desarrollo/curso
# true: exige Bearer token de un usuario con rol "admin"
PROTECT_ADMIN_ROUTES=false
